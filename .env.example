AWS_REGION=us-east-1
S3_BUCKET=your-unique-foodflow-bucket
S3_PREFIX=foodflow/raw
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=FOODFLOW_WH
SNOWFLAKE_DATABASE=FOODFLOW
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_STORAGE_INTEGRATION=FOODFLOW_S3_INT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Dedicated Snowflake role with SELECT only on approved marts
NL_SQL_READONLY_ROLE=FOODFLOW_READER
